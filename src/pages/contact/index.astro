---
import Base from '@/layouts/Base.astro';
import { SOCIAL } from '@/lib/site';

// Web3Forms のアクセスキー（.env の PUBLIC_WEB3FORMS_KEY）。未設定なら送信ボタンを無効化する
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const redirect = new URL('/contact/thanks', Astro.site).href;
---

<Base title="Contact" description="お問い合わせ・ご連絡はこちらのフォームから。">
  <div class="wrap narrow">
    <p class="eyebrow">Contact</p>
    <h1 class="page-title">ご連絡</h1>
    <p class="lede">
      お仕事のご相談、記事への感想、ちょっとした雑談まで。フォームから送っていただければ、メールでお返事します。
    </p>

    <form class="section" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={accessKey ?? ''} />
      <input type="hidden" name="subject" value="[Golcha Works] お問い合わせ" />
      <input type="hidden" name="from_name" value="Golcha Works" />
      <input type="hidden" name="redirect" value={redirect} />
      <!-- スパム対策のハニーポット（人間には見えない） -->
      <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

      <div class="field">
        <label for="name">お名前</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">メールアドレス（返信先）</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="message">内容</label>
        <textarea id="message" name="message" required></textarea>
      </div>

      <p style="margin-top:1.5rem">
        <button class="btn" type="submit" disabled={!accessKey}>送信する</button>
      </p>
      {
        !accessKey && (
          <p class="draft-flag" style="margin:0">PUBLIC_WEB3FORMS_KEY が未設定のため送信できません</p>
        )
      }
    </form>

    <section class="section">
      <div class="section-head">
        <h2>SNS</h2>
      </div>
      <ul class="chips">
        {
          SOCIAL.map((s) => (
            <li>
              <a class="chip" href={s.href} target="_blank" rel="noopener me">
                {s.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
